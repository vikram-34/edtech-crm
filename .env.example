# Combined template of every environment variable in this project.
# The real files live at backend/.env and frontend/.env (both git-ignored):
# copy the matching section below into each file and replace the placeholders.
# Never commit real values.

# ---- backend/.env ----

# Port the Express API listens on (avoid 5000, which macOS AirPlay uses).
PORT=4000

# Supabase dashboard -> your project -> Connect -> "Session pooler" URI.
# URL-encode special characters in the password (e.g. @ -> %40, # -> %23).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-64-char-random-hex-string
# Token lifetime (15m, 12h, 1d, 7d ...)
JWT_EXPIRES_IN=1d

# Frontend origin(s) allowed to call the API. Comma-separate multiple origins, no trailing slash.
CLIENT_URL=http://localhost:5173

# Admin account created/updated by `npm run seed:admin`.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-strong-password

# Number of reverse proxies in front of the API (set to 1 on Render/Railway/Heroku)
# so the rate limiters see the real client IP. Leave unset locally.
# TRUST_PROXY=1

# ---- frontend/.env ----

# Backend API base URL including the /api prefix, no trailing slash.
VITE_API_URL=http://localhost:4000/api
