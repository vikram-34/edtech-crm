{
  "name": "edtech-crm-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express API for the EdTech CRM & Inquiry System (custom bcrypt + JWT auth, Supabase Postgres via pg)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "node scripts/setupDb.js",
    "seed:admin": "node scripts/seedAdmin.js",
    "seed:demo": "node scripts/seedDemo.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1"
  }
}
